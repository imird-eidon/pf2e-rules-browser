<aside class="rb-sidebar">
    {{#if search}}
        {{#if search.hasNames}}
        <h3>{{localize "PF2ERB.Results.Titles"}}</h3>
        <ol class="rb-list">
            {{#each search.names}}
            <li>
                <a data-action="navigate" data-uuid="{{this.uuid}}">
                    <i class="{{this.icon}}"></i>
                    <span class="rb-item-name">{{this.name}}</span>
                    <span class="rb-item-source">{{this.source}}</span>
                </a>
            </li>
            {{/each}}
        </ol>
        {{/if}}

        <h3>{{localize "PF2ERB.Results.FullText"}}</h3>
        {{#if search.building}}
        <div class="rb-progress">
            <div class="rb-progress-bar" style="width: {{search.progress}}%"></div>
        </div>
        <p class="rb-hint">
            <i class="fa-solid fa-spinner fa-spin"></i>
            {{localize "PF2ERB.BuildingIndex"}} ({{search.progress}}%)
        </p>
        {{else if search.hasTexts}}
        <ol class="rb-list rb-text-results">
            {{#each search.texts}}
            <li>
                <a data-action="navigate" data-uuid="{{this.uuid}}">
                    <span class="rb-item-name">{{this.name}}</span>
                    <span class="rb-snippet">{{this.snippet.before}}<mark>{{this.snippet.match}}</mark>{{this.snippet.after}}</span>
                </a>
            </li>
            {{/each}}
        </ol>
        {{else}}
        <p class="rb-hint">{{localize "PF2ERB.NoTextResults"}}</p>
        {{/if}}

        {{#if search.empty}}
        <p class="rb-hint">{{localize "PF2ERB.NoResults"}}</p>
        {{/if}}
    {{else if sidebar.facets}}
        <h3>
            <i class="fa-solid fa-sliders"></i> {{localize "PF2ERB.Advanced.Title"}}
            <a class="rb-facet-save" data-action="saveSearch" data-tooltip="PF2ERB.Advanced.Save">
                <i class="fa-solid fa-floppy-disk"></i>
            </a>
            <a class="rb-facet-clear" data-action="clearFacets" data-tooltip="PF2ERB.Advanced.Clear">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </h3>
        <div class="rb-facets">
            <div class="rb-adv-chips">
                {{#each sidebar.facets.chips}}
                <button type="button" class="rb-adv-chip" data-trait="{{this.slug}}"
                        data-tooltip="PF2ERB.Filter.RemoveTrait">
                    <span>{{this.label}}</span><i class="fa-solid fa-xmark"></i>
                </button>
                {{/each}}
            </div>

            <div class="rb-adv-inputwrap">
                <input type="text" class="rb-adv-input" autocomplete="off"
                       value="{{sidebar.facets.text}}"
                       placeholder="{{localize 'PF2ERB.Filter.Placeholder'}}">
                <div class="rb-adv-suggestions" hidden>
                    {{#each sidebar.facets.traitOptions}}
                    <div class="rb-adv-suggestion" data-trait="{{this.slug}}"
                         data-label="{{this.label}}" hidden>{{this.label}}</div>
                    {{/each}}
                </div>
            </div>

            <label class="rb-facet-label">{{localize "PF2ERB.Advanced.Type"}}</label>
            <select class="rb-facet rb-facet-type">
                <option value="">{{localize "PF2ERB.Advanced.Any"}}</option>
                {{#each sidebar.facets.typeOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>

            <label class="rb-facet-label">{{localize "PF2ERB.Advanced.Level"}}</label>
            <div class="rb-facet-range">
                <input type="number" class="rb-facet rb-facet-level-min" min="0" max="30"
                       value="{{sidebar.facets.levelMin}}" placeholder="{{localize 'PF2ERB.Advanced.Min'}}">
                <span>–</span>
                <input type="number" class="rb-facet rb-facet-level-max" min="0" max="30"
                       value="{{sidebar.facets.levelMax}}" placeholder="{{localize 'PF2ERB.Advanced.Max'}}">
            </div>

            <label class="rb-facet-label">{{localize "PF2ERB.Advanced.Rarity"}}</label>
            <select class="rb-facet rb-facet-rarity">
                <option value="">{{localize "PF2ERB.Advanced.Any"}}</option>
                {{#each sidebar.facets.rarityOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>

            {{#if sidebar.facets.publicationOptions.length}}
            <label class="rb-facet-label">{{localize "PF2ERB.Advanced.Source"}}</label>
            <select class="rb-facet rb-facet-publication">
                <option value="">{{localize "PF2ERB.Advanced.Any"}}</option>
                {{#each sidebar.facets.publicationOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
            {{/if}}

            <label class="rb-facet-label">{{localize "PF2ERB.Advanced.SortBy"}}</label>
            <select class="rb-facet rb-facet-sort">
                <option value="name">{{localize "PF2ERB.Advanced.SortName"}}</option>
                <option value="level" {{#if sidebar.facets.sortByLevel}}selected{{/if}}>{{localize "PF2ERB.Advanced.SortLevel"}}</option>
            </select>
        </div>
    {{else}}
        {{#each sidebar.sections}}
        {{#if this.key}}
        <h3 class="rb-section-toggle" data-action="toggleSection" data-section-key="{{this.key}}">
            <i class="fa-solid fa-chevron-{{#if this.collapsed}}right{{else}}down{{/if}} rb-chevron"></i>
            {{#if this.icon}}<i class="{{this.icon}}"></i> {{/if}}{{this.label}}
            <span class="rb-section-count">{{this.items.length}}</span>
            {{#if this.filterable}}
            <a class="rb-filter-toggle" data-action="toggleFilter" data-section-key="{{this.key}}"
               data-tooltip="PF2ERB.Filter.Toggle">
                <i class="fa-solid fa-filter"></i>
            </a>
            {{/if}}
        </h3>
        {{else}}
        <h3>{{#if this.icon}}<i class="{{this.icon}}"></i> {{/if}}{{this.label}}</h3>
        {{/if}}
        {{#unless this.collapsed}}
        {{#if this.filterable}}
        <div class="rb-filter-panel" data-section-key="{{this.key}}" hidden>
            <div class="rb-filter-chips"></div>
            <div class="rb-filter-inputwrap">
                <input type="text" class="rb-filter-input" autocomplete="off"
                       placeholder="{{localize 'PF2ERB.Filter.Placeholder'}}">
                {{#if this.traitOptions.length}}
                <div class="rb-filter-suggestions" hidden>
                    {{#each this.traitOptions}}
                    <div class="rb-filter-suggestion" data-trait="{{this.slug}}"
                         data-label="{{this.label}}" hidden>{{this.label}}</div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
        </div>
        {{/if}}
        <ol class="rb-list" data-section-key="{{this.key}}">
            {{#each this.items}}
            <li class="{{#if this.active}}active{{/if}}" {{#if this.traits}}data-traits="{{this.traits}}"{{/if}}>
                <a data-action="navigate"
                   {{#if this.uuid}}data-uuid="{{this.uuid}}"{{/if}}
                   {{#if this.pack}}data-pack="{{this.pack}}"{{/if}}
                   {{#if this.view}}data-view="{{this.view}}"{{/if}}
                   {{#if this.facetsJson}}data-facets="{{this.facetsJson}}"{{/if}}>
                    {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
                    <span class="rb-item-name">{{this.name}}</span>
                </a>
                {{#if this.folderKey}}
                <a class="rb-item-folder" data-action="setBookmarkFolder"
                   data-key="{{this.folderKey}}" data-tooltip="PF2ERB.Folder.Assign">
                    <i class="fa-solid fa-folder-tree"></i>
                </a>
                {{/if}}
                {{#if this.removeKey}}
                <a class="rb-item-remove" data-action="removeBookmark"
                   data-key="{{this.removeKey}}" data-tooltip="PF2ERB.RemoveBookmark">
                    <i class="fa-solid fa-xmark"></i>
                </a>
                {{/if}}
            </li>
            {{/each}}
        </ol>
        {{/unless}}
        {{/each}}
    {{/if}}
</aside>
